pipeline {
    agent any
    environment {
        IMAGE = 'baltig.infn.it:4567/epicscs/epicsmng'
    }
    stages {
        stage('Test epics-sscan versions') {
            matrix {
                agent {
                    kubernetes { 
                        yaml """
                        apiVersion: v1
                        kind: Pod
                        spec:
                          imagePullSecrets:
                            - name: baltig-reg-key
                          containers:
                            - name: builder
                              image: ${IMAGE}:${OS}-${BRANCH_NAME}
                              command:
                                - cat
                              tty: true
                        """
                    }
                }
                axes {
                    axis {
                        name 'OS'
                        values 'ubuntu20.04', 'ubuntu22.04', 'ubuntu24.04', 'almalinux9', 'almalinux10'
                    }
                    axis {
                        name 'BASE'
                        values 'R7.0.10', 'R3.16.2', 'R3.15.9', 'R3.14.12.8'
                    }
                    axis {
                        name 'SSCAN'
                        values 'R2-11-6', 'R2-11-5', 'R2-11-4', 'R2-11-3', 'R2-11-2'
                    }
                }
                stages {
                    stage('Test sscan') {
                        steps {
                            container('builder') {
                                sh "printf '%s' 'base = ${BASE}\n' > epicsmng.conf"
                                sh "printf '%s' 'sscan = ${SSCAN}' >> epicsmng.conf"
                                sh 'epicsmng makemodules -v -t epicsmng.conf'
                            }
                        }
                    }
                }
            }
        }
    }
}